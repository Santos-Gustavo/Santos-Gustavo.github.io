# Copy to .env and fill in real values. Never commit .env.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Node-side test/tooling only (fixture seeding, cleanup) — never referenced
# from app/browser code (js/**). See tests/e2e/helpers/supabase-admin.js.
SUPABASE_SERVICE_ROLE_KEY=

# Primary E2E test account. Its Supabase auth user id — E2E_USER_ID — is what
# every fixture/cleanup query scopes to; it must never be a real account.
E2E_EMAIL=
E2E_PASSWORD=
E2E_USER_ID=

# Second E2E test account, used only by rls-isolation.spec.js to prove user A
# cannot see user B's data.
E2E_OTHER_EMAIL=
E2E_OTHER_PASSWORD=

# A project id owned by a different, non-E2E account — used by
# rls-security.spec.js to assert cross-owner access is denied.
E2E_FOREIGN_PROJECT_ID=

# E2E-FIXTURES-001: the suite is self-seeding and self-cleaning.
# `npm run test:e2e` creates the company/client/project/report fixtures it
# needs (tests/e2e/global-setup.js) and deletes everything it created
# afterward (tests/e2e/global-teardown.js), scoped to E2E_USER_ID and
# E2E/test name patterns only. Leave this false — set it to true only
# temporarily, to inspect failed-test data by hand.
E2E_SKIP_CLEANUP=false
